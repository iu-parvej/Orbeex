# .editorconfig — consistent style across editors and IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mdx,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.{html,css,scss}]
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{toml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab
