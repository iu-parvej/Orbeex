{
  "name": "Orbeex Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.90.0",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "postCreateCommand": "rustup component add rustfmt clippy && python -m pip install --user -r scripts/requirements-dev.txt || true",
  "remoteUser": "vscode"
}
