# Normalize all text files to LF in the repository, regardless of the OS.
* text=auto eol=lf

# Explicit text types
*.rs       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.mdx      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files — never touch
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      text eol=lf
*.pdf      binary
*.zip      binary
*.gz       binary
*.wasm     binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary

# Git LFS (enable if large geospatial fixtures are added later)
# *.gpkg   filter=lfs diff=lfs merge=lfs -text
# *.tif    filter=lfs diff=lfs merge=lfs -text
# *.tiff   filter=lfs diff=lfs merge=lfs -text

# Prefer no merge for lockfiles (regenerate instead)
Cargo.lock      merge=ours
pnpm-lock.yaml  merge=ours

# Keep these as diffs in prose
*.md            diff=markdown
*.mdx           diff=markdown

# Linguist: exclude generated/vendored content from language stats
_legacy/*       linguist-vendored
build/*         linguist-generated
