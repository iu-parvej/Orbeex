# Orbeex environment template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
#
# These keys are for LOCAL development only. Orbeex is a desktop app that
# stores LLM keys in the OS keychain at runtime — it never writes them to
# disk in the repo. This template exists only to document the variables.

# ── LLM providers (optional; bring your own key) ─────────────────────
# Leave blank to use a local model instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ── Local/self-hosted model (optional) ───────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Development ──────────────────────────────────────────────────────
RUST_LOG=info
